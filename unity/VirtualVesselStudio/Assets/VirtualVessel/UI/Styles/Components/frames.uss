/*
 * Placement editing (components.md 3.19). The canvas reaches 12px beyond the stream screen so that
 * handles on its edges can be grabbed; that geometry is set in code (FrameCanvas), since it is part of
 * how the canvas works. Only the look is here.
 */
.vv-frame-canvas > .vv-focus-ring {
    left: 8px;
    top: 8px;
    right: 8px;
    bottom: 8px;
    border-radius: var(--vv-radius-s);
}

/* The selected frame: a 2px Primary outline and eight 12px round handles. */
.vv-media-frame__outline {
    position: absolute;
    left: -1px;
    top: -1px;
    right: -1px;
    bottom: -1px;
    border-width: 2px;
    border-color: var(--vv-color-primary);
    display: none;
}

.vv-media-frame--selected > .vv-media-frame__outline {
    display: flex;
}

.vv-media-frame__handle {
    position: absolute;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    margin-top: -6px;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--vv-color-primary);
    background-color: var(--vv-color-surface);
    display: none;
}

.vv-media-frame--selected > .vv-media-frame__handle {
    display: flex;
}

.vv-media-frame__handle--hover {
    width: 16px;
    height: 16px;
    margin-left: -8px;
    margin-top: -8px;
    border-radius: 8px;
}

/* A locked frame shows no handles, only its outline and the badge. */
.vv-media-frame--selected.vv-media-frame--locked > .vv-media-frame__handle {
    display: none;
}

.vv-media-frame__lock {
    position: absolute;
    left: var(--vv-space-s);
    top: var(--vv-space-s);
    margin: 0;
    padding: 2px 10px;
    border-width: 1px;
    border-radius: var(--vv-radius-s);
    border-color: var(--vv-color-border);
    background-color: var(--vv-color-surface-3);
    color: var(--vv-color-text);
    display: none;
}

.vv-media-frame--selected.vv-media-frame--locked > .vv-media-frame__lock {
    display: flex;
}

/* Snap guides: 1px Secondary lines across the stream screen. */
.vv-frame-canvas__guide {
    position: absolute;
    background-color: var(--vv-color-secondary);
}

.vv-frame-canvas__guide--x {
    width: 1px;
    top: -12px;
    bottom: -12px;
}

.vv-frame-canvas__guide--y {
    height: 1px;
    left: -12px;
    right: -12px;
}

/* Position and size while editing, above the frame (below when the frame is at the top). */
.vv-frame-canvas__readout {
    position: absolute;
    margin: -8px 0 0 0;
    padding: 3px 10px;
    border-width: 1px;
    border-radius: var(--vv-radius-s);
    border-color: var(--vv-color-primary);
    background-color: var(--vv-color-surface-3);
    color: var(--vv-color-text);
    white-space: nowrap;
}

.vv-frame-canvas__readout--below {
    margin-top: 8px;
}
