/* The live and setup screens (docs/<lang>/ui/screens/). Layout only; the components bring their own styles. */

.vv-limbs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--vv-space-s);
}

.vv-limbs__title {
    margin-right: var(--vv-space-s);
    color: var(--vv-color-text-2);
}

.vv-limbs__chip {
    margin: 0 var(--vv-space-s) var(--vv-space-xs) 0;
}

.vv-live__layers {
    margin-top: var(--vv-space-m);
}

.vv-live__hint {
    margin-top: var(--vv-space-s);
    white-space: normal;
    color: var(--vv-color-text-2);
}

/* The record control under the stream preview (live.md 3): the state chip and the button in one row. */
.vv-record {
    margin-top: var(--vv-space-s);
}

.vv-record__buttons {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.vv-record__buttons > * {
    margin: 0 var(--vv-space-s) var(--vv-space-xs) 0;
}

.vv-record__problem {
    white-space: normal;
    color: var(--vv-color-text-2);
}

.vv-record__saved {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--vv-space-xs);
}

.vv-record__saved > Label {
    margin-right: var(--vv-space-s);
    white-space: normal;
    color: var(--vv-color-text-2);
}

/* The sound going in, under the record control (live.md 3): per source a mute button, its name, and a meter. */
.vv-audio-strip {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--vv-space-xs);
}

.vv-audio-strip__source {
    flex-direction: row;
    align-items: center;
    margin: 0 var(--vv-space-m) var(--vv-space-xs) 0;
}

.vv-audio-strip__source > Label {
    margin: 0 var(--vv-space-s) 0 var(--vv-space-xs);
    color: var(--vv-color-text-2);
}

.vv-audio-strip__meter {
    width: 120px;
}

/* The audio Card (setup.md 11): a group per source, its name and state, then its rows. */
.vv-audio-card__group {
    padding: var(--vv-space-xs) 0;
    border-bottom-width: 1px;
    border-color: var(--vv-color-border);
}

/* The mixer (setup.md 11): headings and rows share the column widths, so controls line up. */
.vv-audio-card__columns,
.vv-audio-card__row {
    flex-direction: row;
    align-items: center;
}

.vv-audio-card__columns {
    color: var(--vv-color-text-3);
    padding-bottom: var(--vv-space-xs);
    border-bottom-width: 1px;
    border-color: var(--vv-color-border);
}

.vv-audio-card__cell {
    flex-shrink: 0;
    margin-right: var(--vv-space-s);
}

.vv-audio-card__cell--name {
    width: 120px;
}

/* A long state stays inside the name column instead of running under the device. */
.vv-audio-card__cell--name .vv-chip {
    flex-shrink: 1;
    max-width: 100%;
    overflow: hidden;
}

.vv-audio-card__cell--device {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 160px;
    min-width: 0;
    overflow: hidden;
}

.vv-audio-card__cell--gain {
    width: 160px;
}

.vv-audio-card__cell--toggle {
    width: 56px;
}

/* Wide enough for "ミュート" and its help hint, which ran over the level's heading in the toggle column (2026-11-23). */
.vv-audio-card__cell--mute {
    width: 88px;
}

/* The Voice Card's values and notes under a row's description (setup.md 13). */
.vv-voice-settings__note {
    margin-top: 2px;
    color: var(--vv-color-text-2);
    white-space: normal;
}

/* Wider than the other toggles' columns, for its heading and help hint. */
/* Wide enough for "Noise removal" and its help hint (2026-11-23). */
.vv-audio-card__cell--denoise {
    width: 120px;
}

/* A heading, or a control's name, with its help hint after it. */
.vv-audio-card__cell--help {
    flex-direction: row;
    align-items: center;
}

.vv-audio-card__cell--level {
    width: 120px;
    margin-right: 0;
}

.vv-audio-card__cell-label {
    display: none;
    color: var(--vv-color-text-3);
}

/* Too narrow for the columns: each control carries its own name instead of the headings. */
.vv-audio-card--narrow .vv-audio-card__columns,
.vv-audio-card--narrow .vv-audio-card__cell--empty {
    display: none;
}

.vv-audio-card--narrow .vv-audio-card__row {
    flex-wrap: wrap;
    align-items: flex-start;
}

.vv-audio-card--narrow .vv-audio-card__cell-label {
    display: flex;
}

.vv-audio-card--narrow .vv-audio-card__cell--name,
.vv-audio-card--narrow .vv-audio-card__cell--device {
    width: 100%;
    flex-basis: auto;
    margin-bottom: var(--vv-space-xs);
}

.vv-audio-card__note {
    margin-top: var(--vv-space-xs);
    white-space: normal;
    color: var(--vv-color-text-3);
}

.vv-audio-card__heading {
    align-items: flex-start;
}

.vv-audio-card__heading > Label {
    color: var(--vv-color-text);
    -unity-font-style: bold;
}

.vv-audio-card__privacy {
    align-self: flex-start;
    margin-bottom: var(--vv-space-s);
}

.vv-audio-card__problem {
    margin-bottom: var(--vv-space-xs);
    white-space: normal;
    color: var(--vv-color-text-2);
}

/*
 * The recording Card (setup.md 10): values in the text color. A folder's path can be long, so it is under
 * the row's name, where it wraps, and only its buttons are on the right, like the other rows' controls.
 */
.vv-streaming-card__value {
    color: var(--vv-color-text);
}

.vv-streaming-card__note {
    white-space: normal;
    color: var(--vv-color-text-2);
    margin-top: var(--vv-space-xs);
}

.vv-streaming-card__buttons {
    flex-direction: row;
}

.vv-streaming-card__buttons > * {
    margin-left: var(--vv-space-s);
}

.vv-recording-card__value {
    color: var(--vv-color-text);
}

.vv-recording-card__folder {
    margin-top: var(--vv-space-xs);
    white-space: normal;
}

.vv-recording-card__folder-buttons {
    flex-direction: row;
}

.vv-recording-card__pick {
    margin-right: var(--vv-space-s);
}

.vv-capture-card {
    margin-bottom: var(--vv-space-m);
}

.vv-capture-card__problem {
    margin-top: var(--vv-space-xs);
    white-space: normal;
    color: var(--vv-color-text-2);
}

.vv-capture-card__info {
    margin-top: var(--vv-space-s);
    color: var(--vv-color-text-2);
}

.vv-setup__page > .vv-screen__note {
    margin: 0 0 var(--vv-space-m) 0;
}

/* Everything on a settings page keeps M below it, whichever module builds it. */
.vv-setup > *, .vv-setup__page > * {
    margin-bottom: var(--vv-space-m);
}

.vv-setup > .vv-setup__page {
    margin-bottom: 0;
}

/* The small video on a capture Card, only to check the device; 16:9, the video fitted inside. */
.vv-capture-card__preview {
    width: 256px;
    height: 144px;
    margin-top: var(--vv-space-s);
    align-items: center;
    justify-content: center;
    border-radius: var(--vv-radius-s);
    background-color: var(--vv-color-surface-3);
    overflow: hidden;
}

.vv-capture-card__preview-empty {
    color: var(--vv-color-text-3);
}

/* The tracked points over the tracking camera's image (setup.md 4). Primary points on accent-line
   bones, each with an on-accent outline so they show on bright and dark images alike. */
.vv-tracking-overlay {
    --tracking-point: var(--vv-color-primary);
    --tracking-bone: var(--vv-color-accent-line);
    --tracking-outline: var(--vv-color-on-accent);
}

.vv-tracking-card__parts {
    margin-top: var(--vv-space-xs);
    color: var(--vv-color-text-2);
}

.vv-tracking-card__load {
    margin-top: var(--vv-space-xs);
    color: var(--vv-color-text-2);
}

/* The parts' switches, one under another, so they fit a row's control (at most 260px) in every language. */
.vv-tracking-card__toggles {
    align-items: flex-start;
}

.vv-tracking-card__toggles > * {
    margin: 2px 0;
}

/* The avatar Card (setup.md 5): the model's own image, square, and its terms of use. */
.vv-avatar-card__thumbnail {
    width: 96px;
    height: 96px;
    margin-top: var(--vv-space-s);
    align-items: center;
    justify-content: center;
    border-radius: var(--vv-radius-s);
    background-color: var(--vv-color-surface-3);
    overflow: hidden;
}

/* Register and the sample, one above the other, at the right like any row's control. */
.vv-avatar-card__register-buttons {
    flex-direction: column;
    align-items: flex-end;
}

/* S between the buttons (user's report, 2026-11-22: they touched). USS has no :first-child, and a rule using it reached
   every button, so each button gets the space above it and the column is pulled up by the same amount. The buttons are
   named by their class: a rule with the universal selector (*) did not reach them. */
.vv-avatar-card .vv-avatar-card__register-buttons {
    /* -S: USS has no calc(). */
    margin-top: -8px;
}

.vv-avatar-card__register-buttons > .vv-button {
    margin-top: var(--vv-space-s);
}

.vv-avatar-card__license-title {
    margin-top: var(--vv-space-m);
    color: var(--vv-color-text);
}

.vv-avatar-card__license-line {
    flex-shrink: 1;
    white-space: normal;
    color: var(--vv-color-text-2);
}

/* The terms in the registration dialog scroll when the window is short. */
.vv-dialog__details.unity-scroll-view {
    max-height: 280px;
}

/*
 * The credits Card (setup.md 8): a row per component, the ones built into another indented, and a
 * license text in a box that scrolls on its own so a long notices file does not stretch the screen.
 */
.vv-credits-card__intro {
    margin-bottom: var(--vv-space-xs);
    white-space: normal;
    color: var(--vv-color-text-2);
}

.vv-credits-card__entry--nested {
    padding-left: var(--vv-space-l);
}

.vv-credits-card__text {
    max-height: 320px;
    margin-bottom: var(--vv-space-s);
    padding: var(--vv-space-s) var(--vv-space-m);
    border-radius: var(--vv-radius-s);
    background-color: var(--vv-color-surface-3);
}

.vv-credits-card__file {
    margin-top: var(--vv-space-s);
    color: var(--vv-color-text);
}

.vv-credits-card__part {
    white-space: normal;
    color: var(--vv-color-text-2);
}

/*
 * The face tuning Card (setup.md 9): the stream, larger than the device previews so the avatar's face
 * can be seen, beside a slider per part with the avatar's movement of that part as a bar under it.
 */
.vv-face-card__intro {
    white-space: normal;
    color: var(--vv-color-text-2);
}

.vv-face-card__layout {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.vv-face-card__picture {
    flex-shrink: 0;
    width: 384px;
    margin: var(--vv-space-m) var(--vv-space-l) 0 0;
}

.vv-face-card__picture > .vv-slider {
    margin-top: var(--vv-space-s);
}

/* The frame the enlarged stream is seen through; the image inside is placed by the Card. */
.vv-face-card__preview {
    width: 384px;
    height: 216px;
    align-items: center;
    justify-content: center;
    border-radius: var(--vv-radius-s);
    background-color: var(--vv-color-surface-3);
    overflow: hidden;
}

/* The sliders' column wraps under the picture rather than be squeezed. UI Toolkit broke the line by the
   minimum width, not by the basis alone: with only the basis, the column shrank beside the picture until
   its text stood one character a line. */
.vv-face-card__parts {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 320px;
    min-width: 320px;
}

.vv-face-card__part {
    margin-top: var(--vv-space-m);
}

/* The bar needs no title of its own; the introduction says what it shows. */
.vv-face-card__part > .vv-progress {
    margin-top: var(--vv-space-xs);
}

.vv-face-card__part > .vv-progress > .vv-progress__header {
    display: none;
}

/* Lighting (setup.md 15): the light's color beside its name, framed so white shows on a light background. */
.vv-lighting-card__swatch {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--vv-color-border);
    border-radius: var(--vv-radius-s);
}

.vv-lighting-card .vv-setting-row__controls > .vv-select {
    flex-grow: 1;
}

/* The picture on the left and the settings scrolling on its right, so the avatar stays in view (setup.md 15).
   On a narrow window the settings wrap below the picture. */
.vv-lighting-card__layout {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.vv-lighting-card__picture {
    flex-shrink: 0;
    width: 448px;
    margin: var(--vv-space-m) var(--vv-space-l) 0 0;
}

.vv-lighting-card__picture-tabs {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--vv-space-s);
}

/* 16:9: the stage view's render target is made in this shape (setup.md 15.2). */
.vv-lighting-card__frame {
    width: 448px;
    height: 252px;
    align-items: center;
    justify-content: center;
    border-radius: var(--vv-radius-s);
    background-color: var(--vv-color-surface-3);
    overflow: hidden;
}

/* Stage view (setup.md 15.2): the view's image filling the frame, and a numbered marker on each light. */
.vv-stage-view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.vv-stage-view__image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.vv-stage-view__marker {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 3px;
    background-color: var(--vv-color-surface);
    color: var(--vv-color-text);
    -unity-font-style: bold;
    font-size: 12px;
    -unity-text-align: middle-center;
    padding: 0;
}

/* The chosen light: larger, with a light ring, so it is told by shape and not by color alone. */
.vv-stage-view__marker--chosen {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 4px;
    background-color: var(--vv-color-surface-3);
    font-size: 14px;
}

.vv-lighting-card__settings {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 320px;
    min-width: 320px;
    max-height: 480px;
    margin-top: var(--vv-space-m);
}

.vv-lighting-card__settings .vv-slider {
    margin-top: var(--vv-space-m);
    margin-right: var(--vv-space-m);
}

/* Under the stage view: which way a drag turns it (setup.md 15.2). */
.vv-lighting-card__view-options {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--vv-space-s);
}

.vv-lighting-card__view-options > .vv-switch {
    margin-right: var(--vv-space-m);
}
