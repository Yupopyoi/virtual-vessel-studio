/* Toggle (components.md 3.3): 44x26 track, 20px thumb. On and off differ by thumb position, not only color. */
.vv-switch {
    flex-direction: row;
    align-items: center;
}

.vv-switch__track {
    width: 44px;
    height: 26px;
    border-width: 1px;
    border-radius: 13px;
    border-color: var(--vv-color-border);
    background-color: var(--vv-color-surface-3);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.vv-switch__thumb {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: var(--vv-color-text-2);
    transition-property: translate;
    transition-duration: 0.15s;
}

.vv-switch__label {
    margin-left: var(--vv-space-s);
    color: var(--vv-color-text);
}

.vv-switch--on > .vv-switch__track {
    background-color: var(--vv-color-primary);
    border-color: var(--vv-color-primary);
}

.vv-switch--on .vv-switch__thumb {
    translate: 18px 0;
    background-color: var(--vv-color-on-accent);
}

.vv-switch:hover > .vv-switch__track {
    border-color: var(--vv-color-accent-line);
}

.vv-switch:disabled .vv-switch__track {
    background-color: var(--vv-color-surface-2);
}

.vv-switch:disabled .vv-switch__thumb {
    background-color: var(--vv-color-disabled);
}

.vv-switch:disabled .vv-switch__label {
    color: var(--vv-color-disabled);
}

.vv-switch__track > .vv-focus-ring {
    border-radius: 17px;
}

.vv-reduced-motion .vv-switch__track,
.vv-reduced-motion .vv-switch__thumb {
    transition-duration: 0s;
}
