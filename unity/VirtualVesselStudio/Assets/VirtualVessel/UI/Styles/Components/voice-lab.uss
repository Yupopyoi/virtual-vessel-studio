/* The Voice Lab screen (system design 14.13 to 14.18). */
.vv-lab > *,
.vv-lab__content > *,
.vv-lab__panel > * {
    margin-bottom: var(--vv-space-m);
}

.vv-lab__lead,
.vv-lab__note {
    white-space: normal;
    color: var(--vv-color-text-2);
}

/* Cards stacked in Voice Lab keep room between them, and a card folded inside another keeps room above it (the user's review, 2026-11-08). */
.vv-lab .vv-card {
    margin-bottom: var(--vv-space-m);
}

.vv-lab .vv-card .vv-card {
    margin-top: var(--vv-space-s);
}

.vv-lab__gap {
    margin-bottom: var(--vv-space-m);
}

/* The S space above, so a row of buttons under a setting row's divider does not touch it (the user's review, 2026-11-11). */
.vv-lab__actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--vv-space-s);
}

.vv-lab__actions > * {
    margin: 0 var(--vv-space-s) var(--vv-space-xs) 0;
}

/* The tiles wrap; each keeps its own right and bottom margin (steps.uss). */
.vv-lab__tiles {
    flex-direction: row;
    flex-wrap: wrap;
}

.vv-lab__slider {
    margin-bottom: var(--vv-space-s);
}

.vv-lab__ends {
    flex-direction: row;
    justify-content: space-between;
    font-size: 11px;
    color: var(--vv-color-text-3);
}

.vv-lab__facts {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: var(--vv-space-s);
    color: var(--vv-color-text);
}

.vv-lab__far {
    margin: var(--vv-space-s) 0;
}

/* A making bar: the meter takes the row's width, Stop at its end, and room before what follows (the user's review, 2026-11-07). */
.vv-lab__busy {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--vv-space-m);
}

.vv-lab__busy > .vv-progress {
    flex-grow: 1;
    flex-shrink: 1;
}

.vv-lab__busy > * {
    margin-right: var(--vv-space-s);
}

.vv-lab__summary {
    flex-direction: row;
    margin: var(--vv-space-xs) 0;
    color: var(--vv-color-text);
}

.vv-lab__summary > .vv-lab__note {
    width: 120px;
    flex-shrink: 0;
}

.vv-lab__summary > .vv-text-body {
    flex-shrink: 1;
    white-space: normal;
}

/* STEP 1's examples: play, the example's name to pick it, and its words. */
.vv-lab__example {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: var(--vv-space-xs);
}

.vv-lab__example > * {
    margin-right: var(--vv-space-s);
}

/* The shelf's words wrap; each keeps its play button beside it. */
.vv-lab__words {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
}

.vv-lab__word {
    flex-direction: row;
    align-items: center;
    margin: 0 var(--vv-space-s) var(--vv-space-xs) 0;
}

/* The request read back as one sentence. */
.vv-lab__ask {
    margin-bottom: var(--vv-space-m);
    padding: var(--vv-space-m);
    border-radius: var(--vv-radius-m);
    border-width: 1px;
    border-color: var(--vv-color-border);
    background-color: var(--vv-color-surface);
}

/* The prompt's name and its help hint on one line. */
.vv-lab__ask-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--vv-space-xs);
}

.vv-lab__ask > .vv-text-body {
    white-space: normal;
    color: var(--vv-color-text);
}

/* STEP 2's held timbres: play, name, summary, go back, remove. */
.vv-lab__held {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: var(--vv-space-xs);
}

.vv-lab__held > .vv-text-body {
    color: var(--vv-color-text);
}

.vv-lab__held > * {
    margin-right: var(--vv-space-s);
}

/* The Made voices tab: one row per voice or run, wrapping on a narrow window. */
.vv-lab__row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: var(--vv-space-xs);
}

.vv-lab__row > * {
    margin-right: var(--vv-space-s);
}

.vv-lab__row-block {
    padding: var(--vv-space-s) 0;
    border-bottom-width: 1px;
    border-color: var(--vv-color-border);
}

/* A voice's name: the row's main text, so it reads first (the user's review, 2026-11-07). */
.vv-lab__name {
    color: var(--vv-color-text);
    -unity-font-style: bold;
}

/* Preparing Voice Lab (screen spec voice-lab 2.1). The terms scroll inside their card, so the agreement stays in view. */
.vv-lab-setup__terms {
    max-height: 360px;
    padding: var(--vv-space-s) var(--vv-space-m);
    margin-bottom: var(--vv-space-m);
    border-width: 1px;
    border-color: var(--vv-color-border);
    border-radius: var(--vv-radius-s);
    background-color: var(--vv-color-surface);
}

.vv-lab-setup__terms-heading {
    white-space: normal;
    -unity-font-style: bold;
    color: var(--vv-color-text);
    margin-top: var(--vv-space-s);
    margin-bottom: var(--vv-space-xs);
}

.vv-lab-setup__terms-item {
    white-space: normal;
    color: var(--vv-color-text-2);
    margin-bottom: var(--vv-space-xs);
}

.vv-lab-setup__step {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--vv-space-s);
}

.vv-lab-setup__step > .vv-chip {
    margin-right: var(--vv-space-s);
}

.vv-lab-setup__step > .unity-label {
    color: var(--vv-color-text);
}

/* A check's result and its button side by side, with room between (the user's review, 2026-11-11). */
.vv-lab-setup__controls {
    flex-direction: row;
    align-items: center;
}

.vv-lab-setup__controls > * {
    margin-left: var(--vv-space-s);
}

.vv-lab-setup__problem {
    white-space: normal;
    color: var(--vv-color-error);
    margin-bottom: var(--vv-space-s);
}

/* The build's record, like a terminal: the newest line at the bottom, scrolling within a few lines. */
.vv-lab-setup__log {
    max-height: 160px;
    padding: var(--vv-space-s) var(--vv-space-m);
    border-width: 1px;
    border-color: var(--vv-color-border);
    border-radius: var(--vv-radius-s);
    background-color: var(--vv-color-bg);
}

.vv-lab-setup__log .unity-label {
    color: var(--vv-color-text-2);
    white-space: normal;
    margin-bottom: 2px;
}
