/* Tab (components.md 3.8): underlined; the selected tab has Text and a 2px Accent Line underline. */
.vv-tabs {
    border-bottom-width: 1px;
    border-color: var(--vv-color-border);
}

/* The tabs' own scroll area: no padding, so page-level scroll styles do not leak in. */
.vv-tabs .unity-scroll-view__content-container {
    padding: 0;
}

.vv-tabs__tab {
    padding: 8px 12px 6px 12px;
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    color: var(--vv-color-text-2);
    white-space: nowrap;
}

.vv-tabs__tab:hover {
    color: var(--vv-color-text);
}

.vv-tabs__tab--selected,
.vv-tabs__tab--selected:hover {
    color: var(--vv-color-text);
    border-color: var(--vv-color-accent-line);
}

.vv-tabs:disabled .vv-tabs__tab {
    color: var(--vv-color-disabled);
}

/* Page index (components.md 3.29): a link per Card under a page's tabs, quieter than the tabs above it. */
.vv-page-index {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

/* App buttons made quieter (two classes, so this wins over the button's own look). */
.vv-page-index > .vv-page-index__link {
    margin: 0 var(--vv-space-s) var(--vv-space-s) 0;
    padding: 4px 10px;
    border-width: 1px;
    border-color: var(--vv-color-border);
    border-radius: var(--vv-radius-control);
    background-color: var(--vv-color-surface-2);
    color: var(--vv-color-text-2);
    font-size: 13px;
}

.vv-page-index > .vv-page-index__link:hover {
    background-color: var(--vv-color-surface-3);
    color: var(--vv-color-text);
}
