# Virtual Vessel Studio

# ------------------------------------------------------------
# Unity generated files
# ------------------------------------------------------------

# Anchored to Unity project roots so that source folders with the same
# names inside Assets/ (for example Application/Runtime/Build) are not ignored.
/unity/*/Library/
/unity/*/Temp/
/unity/*/Obj/
/unity/*/Logs/
/unity/*/MemoryCaptures/
/unity/*/UserSettings/
/unity/*/Build/
/unity/*/Builds/

# Release packages and test results written by tools/release and tools/unity.
/build/

# MediaPipeUnityPlugin and its models, put in place by tools/deps/fetch-mediapipe.ps1
# (tracking detailed design 16.2). StreamingAssets holds nothing else yet.
/unity/VirtualVesselStudio/Packages/com.github.homuler.mediapipe/
/unity/VirtualVesselStudio/Assets/StreamingAssets/
/unity/VirtualVesselStudio/Assets/StreamingAssets.meta

# Logs left at the repository root by Unity Hub before the project moved.
/Logs/

# Unity-generated IDE/project files
*.sln
*.slnx
*.csproj
*.csproj.user
*.unityproj
*.pidb
*.booproj
*.svd

# Unity crash information
sysinfo.txt

# ------------------------------------------------------------
# Visual Studio / IDE
# ------------------------------------------------------------

.vs/
.idea/
.vscode/

*.suo
*.user
*.userosscache
*.sln.docstates

_ReSharper*/
*.DotSettings.user

# ------------------------------------------------------------
# .NET / C#
# ------------------------------------------------------------

**/bin/
**/obj/

# ------------------------------------------------------------
# C / C++
# ------------------------------------------------------------

**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/compile_commands.json

**/out/
/native/*/build/
**/x64/
**/x86/
**/Debug/
**/Release/
# Release tooling, not a build output (Git matches case-insensitively on Windows).
!/tools/release/

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

**/.venv/
**/venv/
**/__pycache__/

*.py[cod]
*.pyd

**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

**/.coverage
**/htmlcov/

**/*.egg-info/
**/.eggs/

# Local environment variables
.env
.env.*
!.env.example

# ------------------------------------------------------------
# Runtime / generated data
# ------------------------------------------------------------

*.log
*.tmp
*.temp

/local-data/
/runtime-data/

# ------------------------------------------------------------
# OS-generated files
# ------------------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Backup / temporary files
# ------------------------------------------------------------

*~
*.bak
*.swp
*.swo

# ------------------------------------------------------------
# Capture native plugin built by tools/native/build-capture.ps1; kept out of Git until how it is
# distributed is decided (capture detailed design 17)
# ------------------------------------------------------------

/unity/VirtualVesselStudio/Assets/VirtualVessel/Capture/Plugins/
/unity/VirtualVesselStudio/Assets/VirtualVessel/Capture/Plugins.meta

# ------------------------------------------------------------
# UI screenshots written by tools/ui/capture-ui.ps1 (UI foundation detailed design 7.10)
# ------------------------------------------------------------

/screenshots/

# ------------------------------------------------------------
# Developers' tracking recordings (tracking detailed design 12.7): they can hold personal movement and
# belong in the Data Root, never here, even when a launch argument points the Data Root inside.
# ------------------------------------------------------------

*.vvtrack
